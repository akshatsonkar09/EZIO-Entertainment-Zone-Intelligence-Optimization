# ==============================================================================
# Project Black Knight — Production .gitignore
# ==============================================================================

# Byte-compiled / Optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Configuration
.env
.env.*
!.env.example


# Testing & Code Quality
.pytest_cache/
.coverage
htmlcov/
desktop.ini

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vector Store & Model Caches (bootstrapped automatically from .npy embeddings / preload script)
data/chroma/
chromadb/
data/models/

# Backups & Logs
*.bak
*.tmp
*.log

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

