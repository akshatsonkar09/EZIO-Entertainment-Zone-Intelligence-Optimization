# ==============================================================================
# Project Black Knight — Production .gitignore
# ==============================================================================

# Byte-compiled / Optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
!.env.template

# Testing & Code Quality
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vector Store (ChromaDB is bootstrapped automatically from .npy embeddings)
data/chroma/
chromadb/

# Backups & Logs
*.bak
*.tmp
*.log

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

