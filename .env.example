# ==============================================================================
# Project Black Knight — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NEVER commit .env to public source control.
# ==============================================================================

# LLM Query Parsing API (Required for natural-language query understanding)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (Optional)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend API Endpoint (Set to your deployed backend URL in production)
VITE_API_BASE_URL=
